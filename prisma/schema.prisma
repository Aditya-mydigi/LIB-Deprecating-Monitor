generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  repos    Repo[]
}

model Repo {
  id            String @id @default(cuid())
  userId        String
  name          String
  fullName      String
  isActive      Boolean @default(true)
  lastScannedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}
